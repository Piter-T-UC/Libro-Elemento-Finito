% Paleta base heredada de Tarea1_ICM3323.tex (identidad visual del curso)
\RequirePackage{xcolor}

\definecolor{ucred}{RGB}{117,26,41}    % granate institucional -- ecuaciones importantes, titulos
\definecolor{ucblue}{RGB}{45,70,95}    % azul pizarra (antes "devcolor") -- definiciones
\definecolor{ucteal}{RGB}{20,110,100}  % verde azulado -- ejemplos resueltos
\definecolor{ucamber}{RGB}{175,120,20} % ambar -- observaciones
\definecolor{ucgray}{RGB}{45,45,45}    % gris carbon -- teoremas/demostraciones

% Tonos auxiliares
\colorlet{ucredlight}{ucred!5}
\colorlet{ucbluelight}{ucblue!5}
\colorlet{ucteallight}{ucteal!5}
\colorlet{ucamberlight}{ucamber!6}
\colorlet{ucgraylight}{ucgray!4}

